{
  "data_asset_type": "CustomsManifest",
  "expectation_suite_name": "manifests_quality_contract",
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "manifest_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "supplier_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "declared_weight_kg",
        "min_value": 0.1,
        "max_value": 100000.0
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "part_number",
        "regex": "^A[0-9]{3}[0-9]{3}[0-9]{2}$"
      }
    }
  ]
}