{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(asctime)s [%(levelname)s] %(name)s (%(filename)s:%(lineno)d): %(message)s"
    },
    "json": {
      "format": "{\"timestamp\": \"%(asctime)s\", \"level\": \"%(levelname)s\", \"logger\": \"%(name)s\", \"file\": \"%(filename)s\", \"line\": %(lineno)d, \"message\": \"%(message)s\"}"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "standard",
      "stream": "ext://sys.stdout"
    },
    "file_json": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "control_tower.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf8"
    }
  },
  "loggers": {
    "": {
      "handlers": ["console", "file_json"],
      "level": "DEBUG",
      "propagate": true
    },
    "pyspark": {
      "handlers": ["console"],
      "level": "WARN",
      "propagate": false
    },
    "kafka": {
      "handlers": ["console"],
      "level": "WARN",
      "propagate": false
    },
    "urllib3": {
      "handlers": ["console"],
      "level": "WARN",
      "propagate": false
    }
  }
}