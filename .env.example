# ==============================================================================
# STERN-WATCH CONTROL TOWER: ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- LLM ENGINE & AGENTS ---
GROQ_API_KEY="your_groq_api_key_here"
LLM_MODEL_NAME="llama-3.3-70b-versatile"
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# --- POWER BI EMBEDDED ANALYTICS ---
POWERBI_TENANT_ID="your_powerbi_tenant_id_here"
POWERBI_CLIENT_ID="your_power_client_id_here"
POWERBI_CLIENT_SECRET="your_powerbi_client_secret_here"
POWERBI_WORKSPACE_ID="your_powerbi_workspace_id_here"
POWERBI_REPORT_ID="your_report_id_here"

# --- KNOWLEDGE GRAPH & DATABASES ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password123"

POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="control_tower_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password123"

# --- STREAMING & MESSAGING BUS ---
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TELEMETRY_TOPIC="raw_freight_telemetry"
KAFKA_ALERTS_TOPIC="supply_chain_alerts"
REDIS_URL="redis://localhost:6379/0"

# --- SECURITY & HITL AUDIT ---
HITL_HMAC_SECRET_KEY="super-secret-cryptographic-signing-key"
ENCRYPTION_AES_KEY="your-32-byte-base64-aes-key"
